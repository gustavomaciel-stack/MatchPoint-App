generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MatchStatus {
  ABERTA
  COMPLETA
  CONCLUIDA
  CANCELADA
}

enum ParticipationStatus {
  CONFIRMADA
  CANCELADA
}

enum Role {
  USER
  ADMIN
}

model User {
  id           String          @id @default(cuid())
  name         String
  email        String          @unique
  passwordHash String
  role         Role            @default(USER)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  matches      Match[]
  teams        Team[]
  participations Participation[]
}

model Match {
  id            String           @id @default(cuid())
  sport         String
  address       String?
  pricePerPerson Int @default(0) // centavos
  notes         String?
  location      String
  date          DateTime
  time          String
  vacancies     Int
  status        MatchStatus      @default(ABERTA)
  organizerId   String
  organizer     User             @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  participations Participation[]

  @@index([organizerId])
}

model Participation {
  id        String              @id @default(cuid())
  matchId   String
  userId    String
  status    ParticipationStatus @default(CONFIRMADA)
  createdAt DateTime            @default(now())
  match     Match               @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([matchId, userId])
  @@index([matchId])
  @@index([userId])
}

model Team {
  id          String @id @default(cuid())
  name        String
  sport       String
  memberCount Int
  ownerId     String
  owner       User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  hosted      TeamMatch[] @relation("Host")
  accepted    TeamMatch[] @relation("Opponent")

  @@unique([ownerId, sport, name])
}

model TeamMatch {
  id             String @id @default(cuid())
  hostId         String
  opponentId     String?
  host           Team @relation("Host", fields: [hostId], references: [id], onDelete: Cascade)
  opponent       Team? @relation("Opponent", fields: [opponentId], references: [id], onDelete: Cascade)
  location       String
  address        String?
  startsAt       DateTime
  playersPerSide Int
  outdoor        Boolean @default(false)
  cancelled      Boolean @default(false)
}
